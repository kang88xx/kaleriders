{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "public",
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.kaleriders.com"
        }
      ],
      "destination": "https://kaleriders.com/:path*",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/sample",
      "destination": "/sample.html"
    },
    {
      "source": "/sample/",
      "destination": "/sample.html"
    }
  ],
  "headers": [
    {
      "source": "/sample",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    },
    {
      "source": "/sample/",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
